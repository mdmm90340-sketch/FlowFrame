+    @staticmethod
+    def _parse_flowframe_gallery(aweme_detail):
+        images = []
+        for image in traverse_obj(aweme_detail, ('images', ..., {dict})):
+            images.append({
+                'width': int_or_none(image.get('width')),
+                'height': int_or_none(image.get('height')),
+                # Douyin uses download_url_list for watermarked copies. FlowFrame
+                # intentionally exposes only the no-watermark url_list mirrors.
+                'urls': traverse_obj(image, ('url_list', ..., {url_or_none})),
+            })
+        if not images:
+            return None
+
+        music = traverse_obj(aweme_detail, ('music', {dict})) or {}
+        audio_urls = traverse_obj(music, ('play_url', 'url_list', ..., {url_or_none}))
+        duration = int_or_none(music.get('duration'))
+        audio = None
+        if audio_urls:
+            audio = {
+                'urls': audio_urls,
+                'duration_ms': duration * 1000 if duration is not None else None,
+                'title': traverse_obj(music, ('title', {str})),
+                'artist': traverse_obj(music, (('author', 'owner_nickname'), {str}, any)),
+            }
+
+        beats_ms = []
+        beats_raw = traverse_obj(music, ('music_image_beats', 'music_image_beats_raw', {str}))
+        if beats_raw:
+            beats = try_call(lambda: json.loads(beats_raw))
+            for beat in traverse_obj(beats, ('time', ...)):
+                beat_ms = int_or_none(beat)
+                if beat_ms is not None:
+                    beats_ms.append(beat_ms)
+
+        return {
+            'version': 1,
+            'images': images,
+            'audio': audio,
+            'beats_ms': beats_ms,
+        }
+
